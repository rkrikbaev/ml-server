{"top":0,"left":0,"height":1300,"width":1914,"_id":43,"_type":"Screen","_items":{"15":{"top":102,"left":17,"_id":15,"_type":"TableDatasource","width":119,"height":40,"z_index":10,"name":"tds1_ss","schema":"{\r\n       \".name\": {type: fp.item.types.primitives.String},\r\n       \".folder\": {type: fp.item.types.primitives.String},\r\n       \".fp_path\": {type: fp.item.types.primitives.String},\r\n       \"type_ss\":{type: fp.item.types.primitives.String},\r\n       \"type_screen\":{type: fp.item.types.primitives.String},\r\n       \"title\":{type: fp.item.types.primitives.String},\r\n       \"comment\":{type: fp.item.types.primitives.String},\r\n       \".ts\": {type: fp.item.types.primitives.Integer},\r\n       \"disabled\": {type: fp.item.types.primitives.Bool},\r\n       \".pattern\": {type: fp.item.types.primitives.String},\r\n       \r\n}","data":"/root/FP/prototypes/model_control/fields","filter":"undefined","config":"{\r\n   //\"id\": \".folder\",\r\n   \r\n  //\"orderBy\": \"se_active\", //(опционально)\r\n//   \"keyCompare\": ([a], [b]) => {\r\n//          // своя функция сортировки\r\n//          // например сортировка по алфавиту\r\n//          if (a < b) return -1;\r\n//          if (a > b) return 1;\r\n//          return 0;\t\r\n//   },  //(опционально)\r\n  \"page\": 1,  //(опционально)\r\n  \"pageSize\": 30,  //(опционально)\r\n  //\"totalCount\": 0,  //(опционально)\r\n  \"timeout\": 60000  //(опционально в миллисекундах)\r\n}\r\n","pageSize":30,"_events":{}},"16":{"_id":16,"_type":"Grid","width":1880,"height":1141,"datasource":"modelsViewDs","header":"","columns":"","config":"{\r\n    \"columns\": [\r\n        \".fp_path\",\r\n        \"model_state\",\r\n        \"task_status\",\r\n        \"task_updated\",\r\n        {\r\n            view: fp.item.view.controls.Button, \r\n            options:{\r\n                text: \"screen/view\",\r\n                events:{\r\n                    click: (event, data, row) =>{\r\n                        const {\".fp_path\":fp_path, type_screen} = row.data.get();\r\n                        \r\n                        const main_path = '/root/FP/prototypes/model_control/content';\r\n                        window.__path = fp_path;\r\n                        \r\n                        fp_dev.getConnection().get(`GET view1, icon from * WHERE .path='${ main_path }' format $to_json`, ([item])=> {\r\n                              if (item &&  item.view1) {\r\n                                  let screen = item.view1;\r\n                                  screen = JSON.parse( screen );\r\n                        \r\n                                  const id = fp_dev.GUID();\r\n                                  const title = fp_path.replace(\"/root/FP/PROJECT/\", \"\");\r\n                        \r\n                                  const window = new fp.item.view.layout.Window({\r\n                                      view:{\r\n                                          view: fp.item.view.primitives.Html,\r\n                                          options:{ html:`<div id=\"${id}\"></div>` }\r\n                                      },\r\n                                      events:{ destroy:()=>{\r\n                                          screen?.destroy();\r\n                                          dialogContext?.clear()\r\n                                      } },\r\n                                      title\r\n                                  }) \r\n                                  \r\n                                  screen = new fp.ui.Screen($(\"#\"+id), screen);\r\n                                  screen.get_element().css({position: \"relative\"});\r\n                                  \r\n                                  const connection = fp_dev.getConnection();\r\n                                  const dialogContext = new fp.Context( connection );\r\n                                  \r\n                                  dialogContext.link( screen );\r\n                              \r\n                              }else{\r\n                                  fp_dev.error(fp_dev.text(\"invalid screen\"));\r\n                              }\r\n                            \r\n                        },() => {\r\n                            fp.rt.select_screen(fp_path);\r\n                        }, undefined);\r\n                        \r\n                        // if (type_screen === \"simple_ekv\") {\r\n                            \r\n                        // } else {\r\n                        //     fp.rt.select_screen(fp_path);\r\n                        // }\r\n                    }\r\n                }\r\n        }},\r\n   ],\r\n   \r\n    \"header\": [\r\n        \"Object\",\r\n        \"Model\",\r\n        \"Task\",\r\n        \"Updated\",\r\n        \"Details\",\r\n      \r\n    ],\r\n    \"pager\": {\r\n        \"page\": 1,\r\n        \"pageSize\":30,\r\n        \"pageSizeValues\": [30, 60, 90],\r\n        \"maxVisible\": 25  \r\n  }\r\n\r\n}\r\n","top":62,"name":"model status ss","left":12,"_events":{}},"36":{"top":15,"left":145,"_id":36,"_type":"Combobox","width":143,"height":30,"name":"reg","options":["Краткосрочный","Долгосрочный"],"title":"region","_events":{}},"37":{"_id":37,"_type":"Rectangle","width":135,"height":40,"background_color":"#a9c8ec","text":"Тип прогноза: ","font_size":15,"border_width":0,"transparent":true,"horizontal_align":"right","_events":{}},"38":{"_id":38,"left":1551,"width":334,"height":40,"_items":{"34":{"top":5,"left":79,"_id":34,"_type":"Combobox","width":255,"height":30,"name":"reg","options":["LSTM","xgboost linear","xgboost tree","baseline повтор последних суток"],"title":"region","_events":{}},"35":{"left":0,"_id":35,"_type":"Rectangle","width":79,"height":40,"background_color":"#a9c8ec","text":"Модель: ","font_size":15,"border_width":0,"transparent":true,"horizontal_align":"right","top":0,"_events":{}}},"_type":"Group","_events":{}},"39":{"_id":39,"left":1338,"width":213,"height":40,"_items":{"32":{"top":5,"left":78,"_id":32,"_type":"Combobox","width":135,"height":30,"name":"reg1","options":["all"],"title":"region","_events":{"input":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\t\t\r\tconst {options, value} = element.get();\r\t\r\tconst objName = options[value];\r\t\r\tconst datasource = context.find_by_name(\"modelsViewDs\");\r\t\r\tif (!objName || value === 0) {\r\t    const fields = [\".name\",\r           \".folder\",\r           \".fp_path\",\r           \"type_ss\",\r           \"type_screen\",\r           \"title\",\r           \"comment\",\r           \".ts\",\r           \"disabled\",\r           \".pattern\"\r        ].join(\", \");\r    \r    \tcontext.get_connection().get(`get ${fields} from * where and(.pattern=$oid('/root/FP/prototypes/model_control/fields'), .fp_path like '^/root/FP/PROJECT') format $to_json`, (res) => {\r    \t    datasource.set({data: res});\r    \t});\r\t    return;\r\t}\r\t\r\tconst objTypeValue = context.find_by_name(\"obj_type\").get(\"value\");\r\t\r\tconst fields = [\".name\",\r       \".folder\",\r       \".fp_path\",\r       \"type_ss\",\r       \"type_screen\",\r       \"title\",\r       \"comment\",\r       \".ts\",\r       \"disabled\",\r       \".pattern\"\r    ].join(\", \");\r    \r    let baseFilter = `and(.pattern=$oid('/root/FP/prototypes/model_control/fields'), .fp_path like '^/root/FP/PROJECT/KAZ')`;\r    \r    \r    // const queryOptions = {\r    //     0: (name) => {\r    //         return `and(and(.fp_path like '^/root/FP/PROJECT/KAZ', .name='${name}'), .pattern=$oid('/root/FP/prototypes/line terminal/fields'))`;\r    //     },\r    //     1: (name) => {\r    //         return `.folder=$oid('/root/FP/PROJECT/KAZ/${name}')`;\r    //     }, \r    //     2: (name) => {\r    //         return `and(and(.fp_path like '^/root/FP/PROJECT/KAZ', .name='${name}'), .pattern=$oid('/root/FP/prototypes/substation/fields'))`;\r    //     }\r    // };\r    \r    \r\tcontext.get_connection().get(`get ${fields} from * where ${baseFilter} format $to_json`, (res) => {\r\t    datasource?.set({ data: res.filter(r => r[\".fp_path\"].includes(objName)) })\r\t});\r}"}}}},"33":{"left":0,"_id":33,"_type":"Rectangle","width":78,"height":40,"background_color":"#a9c8ec","text":"Объект: ","font_size":15,"border_width":0,"transparent":true,"horizontal_align":"right","top":0,"_events":{}}},"_type":"Group","_events":{}},"40":{"_id":40,"left":1108,"width":230,"height":40,"_items":{"28":{"top":5,"left":115,"_id":28,"_type":"Combobox","width":115,"height":30,"name":"obj_type","options":["ЛЭП","МЭС","Подстанция"],"title":"region","_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r\tconst combobox = context.find_by_name(\"reg1\");\r\t\r\tconst value = element.get(\"value\");\r\t\t\r\tconst base = \"and(.pattern=$oid('/root/FP/prototypes/model_control/fields'), .fp_path like '^/root/FP/PROJECT')\";\r\t\r\tconst mes = `get .folder from * where ${base}`;\r\tconst lep = `get .folder, .folder > .pattern as '.pattern' from * where ${base}`;\r\tconst substation = `get .folder from * where ${base}`;\r\t\r\tconst queryOptions = [lep, mes, substation];\r\t\r\tconst lepPattern = \"{3,111}\";\r\tconst substationPattern = \"\";\r\t\r\tcontext.get_connection().get(`${queryOptions[value]} format $to_json`, (res) => {\r\t    let options = res;\r\t    \r\t    if (value === 1) {\r\t        options = options.map(o => {\r\t            return o[\".folder\"].replace(\"/root/FP/PROJECT/KAZ/\", \"\").split(\"/\")[0];\r\t        });\r\t    } else if (value === 0) {\r\t        options = options.filter(o => o[\".pattern\"] === lepPattern).map(o => {\r\t            return o[\".folder\"].split(\"/\").pop();\r\t        });\r\t    } else {\r\t        options = options.map(o => {\r\t            return o[\".folder\"].replace(\"/root/FP/PROJECT/KAZ/\", \"\").split(\"/\")[1];\r\t        });\r\t    }\r\t    \r\t     options.unshift(\"All\");\r\t  \r\t    combobox.set({options, value: -1});\r\t}, console.error);  \r}"}},"input":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r\tconst combobox = context.find_by_name(\"reg1\");\r\t\r\tconst value = element.get(\"value\");\r\t\t\r\tconst base = \"and(.pattern=$oid('/root/FP/prototypes/model_control/fields'), .fp_path like '^/root/FP/PROJECT')\";\r\t\r\tconst mes = `get .folder from * where ${base}`;\r\tconst lep = `get .folder, .folder > .pattern as '.pattern' from * where ${base}`;\r\tconst substation = `get .folder from * where ${base}`;\r\t\r\tconst queryOptions = [lep, mes, substation];\r\t\r\tconst lepPattern = \"{3,111}\";\r\tconst substationPattern = \"\";\r\t\r\tcontext.get_connection().get(`${queryOptions[value]} format $to_json`, (res) => {\r\t    let options = res;\r\t    \r\t    if (value === 1) {\r\t        options = options.map(o => {\r\t            return o[\".folder\"].replace(\"/root/FP/PROJECT/KAZ/\", \"\").split(\"/\")[0];\r\t        });\r\t    } else if (value === 0) {\r\t        options = options.filter(o => o[\".pattern\"] === lepPattern).map(o => {\r\t            return o[\".folder\"].split(\"/\").pop();\r\t        });\r\t    } else {\r\t        options = options.map(o => {\r\t            return o[\".folder\"].replace(\"/root/FP/PROJECT/KAZ/\", \"\").split(\"/\")[1];\r\t        });\r\t    }\r\t    \r\t    options.unshift(\"All\");\r\t  \r\t    combobox.set({options, value: -1});\r\t}, console.error);   \r}"}}}},"29":{"left":0,"_id":29,"_type":"Rectangle","width":115,"height":40,"background_color":"#a9c8ec","text":"Тип объекта: ","font_size":15,"border_width":0,"transparent":true,"horizontal_align":"right","top":0,"_events":{}}},"_type":"Group","_events":{}},"41":{"_id":41,"left":763,"width":325,"height":40,"_items":{"30":{"top":5,"left":85,"_id":30,"_type":"Combobox","width":240,"height":30,"name":"reg","options":["Потребления электроэнергии","Потерь электроэнергии","Генерации электроэнергии"],"title":"region","_events":{