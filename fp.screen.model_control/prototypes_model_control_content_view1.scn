{"_id":81,"_index":{"1":[],"5":[],"21":[],"27":[],"28":[],"29":[],"30":[],"31":[],"41":[],"42":[],"44":[],"45":[],"49":[],"52":[],"57":[],"63":[],"65":[],"67":[],"68":[],"69":[],"70":[],"71":[],"72":[],"73":[],"75":[],"77":[],"79":[],"80":[],"81":[]},"_items":{"1":{"_id":1,"_type":"Trend","height":620,"left":85,"name":"trend","time_step":"hour","top":84,"width":1180,"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__trend_element = element;\r}"}}}},"5":{"_id":5,"_type":"Rectangle","background_color":"transparent","bold":true,"border_style":"","font_size":20,"horizontal_align":"left","left":1349,"padding_left":10,"text":"Model description","top":99,"width":460,"_events":{}},"21":{"top":200,"left":1359,"_id":21,"_type":"Rectangle","width":276,"height":30,"border_color":"transparent","background_color":"transparent","text":"Model type:","horizontal_align":"left","font_size":16,"_events":{}},"27":{"top":240,"left":1359,"_id":27,"_type":"Rectangle","width":266,"height":30,"border_color":"transparent","background_color":"transparent","text":"Model version:","horizontal_align":"left","font_size":16,"_events":{}},"28":{"top":155,"left":1359,"_id":28,"_type":"Rectangle","width":259,"height":40,"border_color":"transparent","background_color":"transparent","text":"Model name","horizontal_align":"left","font_size":16,"_events":{}},"29":{"top":457,"left":1359,"_id":29,"_type":"Rectangle","width":259,"height":46,"border_color":"transparent","background_color":"transparent","text":"Model status:","horizontal_align":"left","font_size":16,"_events":{}},"30":{"_id":30,"_type":"Rectangle","background_color":"transparent","bold":true,"border_style":"","font_size":20,"horizontal_align":"left","left":1354,"padding_left":10,"text":"Metrics","top":547,"width":442,"_events":{}},"31":{"top":366,"left":1359,"_id":31,"_type":"Rectangle","width":259,"height":43,"border_color":"transparent","background_color":"transparent","text":"Auto call time:","horizontal_align":"left","font_size":16,"_events":{}},"41":{"top":592,"left":1364,"_id":41,"_type":"Rectangle","width":85,"height":30,"border_color":"transparent","background_color":"transparent","text":"MAPE:","horizontal_align":"left","font_size":16,"_events":{}},"42":{"top":593,"left":1478,"_id":42,"_type":"InOut","width":69,"height":28,"border_width":0,"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__mape = element;\r}"}}}},"44":{"top":635,"left":1364,"_id":44,"_type":"Rectangle","width":85,"height":30,"border_color":"transparent","background_color":"transparent","text":"MAE:","horizontal_align":"left","font_size":16,"_events":{}},"45":{"top":677,"left":1364,"_id":45,"_type":"Rectangle","width":85,"height":40,"border_color":"transparent","background_color":"transparent","text":"RMSE:","horizontal_align":"left","font_size":16,"_events":{}},"49":{"top":636,"left":1478,"_id":49,"_type":"InOut","width":69,"height":28,"border_width":0,"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__mae = element;\r}"}}}},"52":{"top":681,"left":1478,"_id":52,"_type":"InOut","width":69,"height":28,"border_width":0,"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__rmse = element;\r}"}}}},"57":{"top":40,"left":85,"_id":57,"_type":"CatalogSelect","catalog":"","visible":false,"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__catalog_select = element;\r    // const path = window.__path;\r    // const split_path = path.split(\"/\");\r    // const modal_name = split_path.pop();\r    \r    // element.set({catalog : \"/root/FP/catalogs/\" + modal_name});\r    // // /root/FP/catalogs/model_control_p_load\r    // console.log(`Catalog`, element.get(\"catalog\"));\r}"}},"input":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\n    const path = window.__path;\n    const conn = fp_dev.getConnection();\n    // console.log(`path`, path);\n    const split_path = path.split(\"/\");\n    const modal_name = split_path.pop();\n    const model_folder = path.replace(modal_name, \"\");\n    const pattern = '/root/FP/prototypes/model_control/fields';\n    \n    const config = element.get(\"config\");\n    \n    // console.log(`config`, config);\n    \n    const model_name = config[\".name\"];\n    const model_type = config.model_type;\n    const model_version = config.model_version;\n    \n    conn.edit_or_create_object({\n        \".name\": modal_name, \n        \".folder\" : model_folder,\n        \".pattern\" : pattern,\n        model_name : model_name,\n        model_type : model_type,\n        model_version : model_version\n    },()=>{console.log(\"Модель обновлена\");}, \t\n    \t(e)=>{console.log(\"Ошибка!\",e)}, 5000);\n    \n    \n    \n}"}}}},"63":{"top":460,"left":1620,"_id":63,"_type":"InOutText","width":265,"align":"left","border_width":0,"padding":4,"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__status = element;\r}"}}}},"65":{"top":411,"left":1359,"_id":65,"_type":"Rectangle","width":259,"height":43,"border_color":"transparent","background_color":"transparent","text":"Exec format:","horizontal_align":"left","font_size":16,"_events":{}},"67":{"top":520,"left":1365,"_id":67,"_type":"Rectangle","width":265,"height":30,"visible":false,"text":"Summary metrics","_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\n    \n    \n    \n    async function update(){\n        const path = window.__path;\n        const split_path = path.split(\"/\");\n        const model_object = split_path[split_path.length - 1];\n        const pattern = '/root/FP/prototypes/model_control/fields';\n        await ControlModelData(model_object,pattern);\n        \n        context.setTimeout( update, 1000 );\n    }\n    \n    async function ControlModelData(model_object, pattern) {\n        \n        // ################## SET CATALOG ROOT ####################\n    \n        const query = `GET model_mape, model_rmse, model_mae from * WHERE AND(.name = '${model_object}', .pattern = $oid('${pattern}') )`;\n    \n        context.get_connection().find(query, (result) => {\n            // console.log(result);\n            context.__mape.set({value : result.set[0].fields.model_mape});\n            context.__mae.set({value : result.set[0].fields.model_mae});\n            context.__rmse.set({value : result.set[0].fields.model_rmse});\n        },(e) => {\n            console.log(`Set metrics error:`, e);\n        },5000);\n    }\n    \n    update();\n    \n}"}}}},"68":{"_id":68,"_type":"Rectangle","background_color":"transparent","bold":true,"border_style":"","font_size":20,"horizontal_align":"left","left":1349,"padding_left":10,"text":"Execution","top":319,"width":460,"_events":{}},"69":{"top":295,"left":1360,"_id":69,"_type":"Rectangle","width":265,"height":30,"visible":false,"text":"Execution","_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\n    \n    async function update(){\n        const path = window.__path;\n        const split_path = path.split(\"/\");\n        const model_object = split_path[split_path.length - 1];\n        const pattern = '/root/FP/prototypes/model_control/fields';\n        await ControlModelData(model_object,pattern);\n        \n        context.setTimeout( update, 1000 );\n    }\n    \n    \n    \n    async function ControlModelData(model_object, pattern) {\n        \n        // ################## SET CATALOG ROOT ####################\n        // const query = `GET task_status, task_message from * WHERE AND(.name = 'model_control_p_load2', .pattern = $oid('/root/FP/prototypes/model_control/fields') )`;\n        const query = `GET task_status, task_message from * WHERE AND(.name = '${model_object}', .pattern = $oid('${pattern}') )`;\n    \n        context.get_connection().find(query, (result) => {\n            // console.log(result);\n            context.__status.set({value : result.set[0].fields.task_status});\n            context.__exec.get\n            context.__message.set({value : result.set[0].fields.task_message});\n        },(e) => {\n            console.log(`Set execution data error:`, e);\n        },5000);\n    }\n    \n    update();\n    \n}"}}}},"70":{"top":415,"left":1620,"_id":70,"_type":"Combobox","options":["Auto","Stopped","One shot"],"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__exec = element;\r}"}}}},"71":{"top":370,"left":1620,"_id":71,"_type":"DateTimePicker","_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__call_time = element;\r}"}}}},"72":{"top":560,"left":1620,"_id":72,"_type":"InOutText","width":265,"align":"left","border_width":0,"padding":4,"height":150,"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__message = element;\r}"}}}},"73":{"top":515,"left":1620,"_id":73,"_type":"Rectangle","width":259,"height":46,"border_color":"transparent","background_color":"transparent","text":"Message:","horizontal_align":"left","font_size":16,"_events":{}},"75":{"top":240,"left":1620,"_id":75,"_type":"Combobox","width":265,"options":["V1","V2"],"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\n    context.__model_version = element;\n    \n    const path = window.__path;\n    const split_path = path.split(\"/\");\n    const model_object = split_path[split_path.length - 1];\n    const pattern = '/root/FP/prototypes/model_control/fields';\n    \n    \n    const query = `GET model_name, model_version, model_type from * WHERE AND(.name = '${model_object}', .pattern = $oid('${pattern}') )`;\n\n    context.get_connection().find(query, (model_info) => {\n        \n        context.__catalog_pattern = model_info.set[0].fields.model_name;\n        \n        const Type_query = `GET .name from * WHERE AND(.folder = $oid('/root/FP/catalogs/${model_info.set[0].fields.model_name}/content'), .pattern = $oid('/root/FP/catalogs/${model_info.set[0].fields.model_name}/fields'))`;\n        \n        context.get_connection().find(Type_query, (result) => {\n            console.log(`Final version result`, result);\n            let models_version = [];\n            for(let i = 0; i < result.total; i++){\n                models_version.push(result.set[i].fields[\".name\"]);\n            }\n            \n            element.set({options: models_version});\n            \n        },(e) => {\n            console.log(`${fp_dev.text(\"Ошибка, не удалось получить список версий модели\")}:`, e);\n        },5000);    \n            \n        },(e) => {\n            console.log(`Set settings data error:`, e);\n    },15000);\n    \n    \n}"}},"input":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    \r    const name = element.get(\"options\")[element.get(\"value\")];\r    \r    const query = `GET model_type from * WHERE AND( .name = '${name}', .folder = $oid('/root/FP/catalogs/${context.__catalog_pattern}/content'), .pattern = $oid('/root/FP/catalogs/${context.__catalog_pattern}/fields'))`;\r    \r    // console.log(`query`, query);\r    \r    context.get_connection().find(query, (result) => {\r            \r            // console.log(`Pattern`, context.__catalog_pattern);\r            context.__model_type.set({value: result.set[0].fields.model_type});\r            \r        },(e) => {\r            console.log(`${fp_dev.text(\"Ошибка не удалось установить тип версии\")}:`, e);\r        },10000);    \r}"}}}},"77":{"top":150,"left":1620,"_id":77,"_type":"InOutText","width":265,"align":"left","border_width":0,"padding":4,"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__model_name = element;\r}"}}}},"79":{"top":280,"left":1645,"_id":79,"_type":"Button","_links":{"text":{"type":"SCRIPT","script":"function(VARS,element,context){\n    return fp_dev.text(\"Save\");\n}"}},"width":210,"text":"","_events":{"click":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\n    const path = window.__path;\n    const conn = fp_dev.getConnection();\n    const split_path = path.split(\"/\");\n    const modal_name = split_path.pop();\n    const model_folder = path.replace(\"/\" + modal_name, \"\");\n    const pattern = '/root/FP/prototypes/model_control/fields';\n    \n    const model_type = context.__type.get(\"value\");\n    const model_version = context.__model_version.get(\"options\");\n    \n    // console.log(`modal_name`, modal_name);\n    // console.log(`model_folder`, model_folder);\n    // console.log(`pattern`, pattern);\n    \n    // console.log(`model_version`, context.__model_version);\n    \n    conn.edit_or_create_object({\n        \".name\": modal_name, \n        \".folder\" : model_folder,\n        \".pattern\" : pattern,\n        model_type : model_type,\n        model_version : model_version[context.__model_version.get(\"value\")]\n    },()=>{console.log(\"Модель обновлена\");}, \t\n    \t(e)=>{console.log(\"Ошибка!\",e)}, 5000);\n    \n    \n    \n}"}}}},"80":{"top":70,"left":1355,"_id":80,"_type":"Rectangle","width":285,"height":35,"visible":false,"transparent":true,"text":"Model discription","_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\n    \n    const path = window.__path;\n    const split_path = path.split(\"/\");\n    const model_object = split_path[split_path.length - 1];\n    const pattern = '/root/FP/prototypes/model_control/fields';\n    \n    \n    const query = `GET model_name, model_version, model_type from * WHERE AND(.name = '${model_object}', .pattern = $oid('${pattern}') )`;\n\n    context.get_connection().find(query, (result) => {\n        \n            const models_version = context.__model_version.get(\"options\");\n            \n            context.__model_name.set({value : result.set[0].fields.model_name});\n            context.__model_type.set({value : result.set[0].fields.model_type});\n            context.__model_version.set({value : models_version[result.set[0].fields.model_version]});\n            \n            \n        },(e) => {\n            console.log(`Set settings data error:`, e);\n    },5000);\n}"}}}},"81":{"top":195,"left":1620,"_id":81,"_type":"InOutText","width":265,"align":"left","border_width":0,"padding":4,"_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\r    context.__model_type = element;\r}"}}}}},"_type":"Screen","height":800,"left":0,"top":0,"width":1914,"background_color":"#ffffff","_events":{"init":{"type":"SCRIPT","value":{"script":"function(VARS,element,context){\n    \n    const screen = fp.rt.get_screen();\n    const [Trend] = screen.find_by_name(\"trend\");\n    \n    const path = window.__path;\n    const split_path = path.split(\"/\");\n    const model_name = split_path[split_path.length - 1];\n    \n    const archive_folder = path + \"/archives\"; // Archives folder\n    const pattern1 = '/root/.patterns/ARCHIVE'; // Atchives Pattern\n    \n    \n    \n    \n    const query = `GET .name, .path from * WHERE AND(.folder = $oid('${archive_folder}'), .pattern = $oid('${pattern1}') )`;\n    \n    \n    let arr = [];\n    context.get_connection().find(query, (result) => {\n        for(let i = 0; i < result.total; i++){\n             arr.push(\n                 {\n                      \"oid\": result.set[i].fields[\".path\"],\n                      \"caption\": result.set[i].fields[\".name\"],\n                      \"axis\": \"y\",\n                      \"settings\": {\n                        \"strokeWidth\": 1,\n                        \"pointSize\": 1,\n                        \"drawPoints\": false,\n                        \"stepPlot\": true,\n                        \"visibility\": \"on\"\n                      }\n                    }\n                 );        \n        }\n        // console.log(`Archives list`, arr);\n        context.__trend_element.set({archives:arr});\n    },(e) => {\n        console.log(`Set archive error:`, e);\n    },5000);\n    \n}"}}}}